.25; margin: 1.75rem 0 0.5rem; letter-spacing: -0.01em; }\n  h2 { font-size: 1.2rem; margin: 2.5rem 0 0.6rem; letter-spacing: -0.005em; }\n  p { margin: 0 0 1rem; }\n  a { color: var(--brand); text-decoration: underline; text-underline-offset: 2px; }\n  a:hover { color: var(--brand-ink); }\n  .lede { font-size: 1.12rem; color: var(--text); }\n  .muted { color: var(--muted); font-size: 0.94rem; }\n  hr { border: 0; border-top: 1px solid var(--rule); margin: 2.25rem 0; }\n  .notice {\n    background: var(--notice-bg);\n    border-left: 4px solid var(--notice-edge);\n    padding: 1rem 1.15rem;\n    margin: 1.5rem 0;\n    border-radius: 0 4px 4px 0;\n  }\n  .notice p:last-child { margin-bottom: 0; }\n  ul { padding-left: 1.25rem; margin: 0 0 1rem; }\n  li { margin-bottom: 0.9rem; }\n  .alt-name { font-weight: 600; }\n  .stats {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 1.5rem 1.5rem;\n    margin: 1.75rem 0 0;\n  }\n  @media (min-width: 34rem) {\n    .stats { grid-template-columns: repeat(4, 1fr); }\n  }\n  .stat-value {\n    font-size: clamp(1.75rem, 6vw, 2.5rem);\n    line-height: 1.1;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n    color: var(--text);\n    font-variant-numeric: proportional-nums;\n  }\n  .stat-label {\n    margin-top: 0.35rem;\n    font-size: 0.85rem;\n    line-height: 1.4;\n    color: var(--muted);\n  }\n  .signoff { margin-top: 0.5rem; font-style: italic; }\n  .attrib { font-style: normal; font-size: 0.86rem; }\n  footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); color: var(--muted); font-size: 0.94rem; }\n</style>\n<!-- Google tag (gtag.js) -->\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-KW3JPB2M7P\"></script>\n<script>\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n  gtag('config', 'G-KW3JPB2M7P');\n</script>\n</head>\n<body>\n<div class=\"wrap\">\n\n  <header>\n    <div class=\